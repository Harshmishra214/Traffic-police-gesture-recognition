e.display.Javascript object>"],"application/javascript":["google.colab.kernel.invokeFunction('display_on_screen', ['BLKB1-GRL2-WG'], {});"]},"metadata":{}}]},{"cell_type":"code","source":["# --- ULTIMATE STABLE GESTURE PREDICTION CODE ---\n","import pickle\n","import numpy as np\n","import cv2\n","import IPython\n","from google.colab import files, output\n","from PIL import Image\n","from base64 import b64decode\n","import io\n","import os\n","\n","print(\"📁 कृपया अपनी दोनों फाइलें चुनें:\")\n","uploaded = files.upload()\n","\n","model_filename = None\n","encoder_filename = None\n","\n","for filename in uploaded.keys():\n","    if 'model' in filename.lower():\n","        model_filename = filename\n","    elif 'encoder' in filename.lower():\n","        encoder_filename = filename\n","\n","if not model_filename or not encoder_filename:\n","    files_list = list(uploaded.keys())\n","    files_list.sort(key=lambda x: os.path.getsize(x), reverse=True)\n","    model_filename = files_list[0]\n","    encoder_filename = files_list[1]\n","\n","with open(model_filename, 'rb') as f:\n","    clf = pickle.load(f)\n","\n","with open(encoder_filename, 'rb') as f:\n","    encoder = pickle.load(f)\n","\n","print(f\"\\n✅ मॉडल लोड हो गया! अब कैमरा चालू हो रहा है...\")\n","\n","def start_webcam():\n","    js = IPython.display.Javascript('''\n","        async function startWebcam() {\n","            const script1 = document.createElement('script');\n","            script1.src = 'https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js';\n","            document.head.appendChild(script1);\n","\n","            const script2 = document.createElement('script');\n","            script2.src = 'https://cdn.jsdelivr.net/npm/@mediapipe/pose/pose.js';\n","            document.head.appendChild(script2);\n","\n","            await new Promise(resolve => setTimeout(resolve, 2000));\n","\n","            const div = document.createElement('div');\n","            div.style.position = 'relative';\n","            div.style.display = 'inline-block';\n","\n","            const video = document.createElement('video');\n","            video.style.display = 'block';\n","            video.width = 640;\n","            video.height = 480;\n","            video.autoplay = true;\n","            div.appendChild(video);\n","\n","            const overlay = document.createElement('div');\n","            overlay.id = 'gesture-overlay';\n","            overlay.style.position = 'absolute';\n","            overlay.style.top = '20px';\n","            overlay.style.left = '20px';\n","            overlay.style.backgroundColor = 'rgba(0, 0, 0, 0.8)';\n","            overlay.style.color = '#00FF00';\n","            overlay.style.padding = '12px 24px';\n","            overlay.style.fontSize = '22px';\n","            overlay.style.fontWeight = 'bold';\n","            overlay.style.fontFamily = 'monospace';\n","            overlay.style.borderRadius = '8px';\n","            overlay.innerText = 'Gesture: Waiting for pose...';\n","            div.appendChild(overlay);\n","\n","            document.body.appendChild(div);\n","\n","            const stream = await navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480 } });\n","            video.srcObject = stream;\n","            await new Promise((resolve) => video.onloadedmetadata = resolve);\n","\n","            const pose = new Pose({\n","                locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/pose/${file}`\n","            });\n","\n","            pose.setOptions({\n","                modelComplexity: 1,\n","                smoothLandmarks: true,\n","                minDetectionConfidence: 0.5,\n","                minTrackingConfidence: 0.5\n","            });\n","\n","            pose.onResults(results => {\n","                if (results.poseLandmarks) {\n","                    let landmarks = [];\n","                    results.poseLandmarks.forEach(lm => {\n","                        landmarks.push(lm.x, lm.y, lm.z);\n","                    });\n","\n","                    // सीधे Colab पाइथन को डेटा भेजना\n","                    google.colab.kernel.invokeFunction('notebook.predict_gesture', [landmarks], {});\n","                }\n","            });\n","\n","            const canvas = document.createElement('canvas');\n","            canvas.width = video.videoWidth;\n","            canvas.height = video.videoHeight;\n","            const ctx = canvas.getContext('2d');\n","\n","            setInterval(async () => {\n","                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);\n","                await pose.send({ image: canvas });\n","            }, 300);\n","        }\n","        startWebcam();\n","    ''')\n","    IPython.display.display(js)\n","\n","def predict_gesture(landmarks):\n","    try:\n","        if len(landmarks) == 99:\n","            X_live = np.array([landmarks])\n","            y_pred_encoded = clf.predict(X_live)\n","            predicted_gesture = encoder.inverse_transform(y_pred_encoded)[0]\n","\n","            # कंसोल में प्रिंट करना\n","            print(f\"🎯 डिटेक्ट हुआ जेस्चर: {predicted_gesture}\")\n","\n","            # वीडियो के ऊपर स्क्रीन पर दिखाने के लिए जावास्क्रिप्ट भेजना\n","            update_js = IPython.display.Javascript(f\"\"\"\n","                const overlay = document.getElementById('gesture-overlay');\n","                if (overlay) {{\n","                    overlay.innerText = 'Gesture: {predicted_gesture}';\n","                }}\n","            \"\"\")\n","            IPython.display.display(update_js)\n","    except Exception as e:\n","        print(f\"Error: {e}\")\n","\n","output.register_callback('notebook.predict_gesture', predict_gesture)\n","\n","start_webcam()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"r5_XT22ZaZZd","executionInfo":{"status":"ok","timestamp":1787904540843,"user_tz":-330,"elapsed":40556,"user":{"displayName":"Hariom Patel","